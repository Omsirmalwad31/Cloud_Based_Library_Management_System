{
  "uid": "library-system",
  "title": "Library Management - Spring Boot",
  "tags": ["library", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Backend up (1 = UP)",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"library-backend\"}", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "requests/sec", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "HTTP 5xx response rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "JVM heap used (bytes)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Process uptime (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "process_uptime_seconds", "legendFormat": "uptime", "refId": "A"}]
    },
    {
      "id": 6,
      "title": "HTTP p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
